			</FormItem>
			<parameter name="title">CONN_TITLE</parameter>
			<parameter name="formscript"><![CDATA[
function generateBearerToken() {
	// 32 random bytes -> 64 hex chars (~256 bits). Built entirely Java-side to
	// avoid IBM JScript engine quirks with byte[]/regex/JS-vs-Java string methods.
	var sr = new Packages.java.security.SecureRandom();
	var sb = new Packages.java.lang.StringBuilder();
	for (var i = 0; i < 32; i++) {
		// nextInt(256) -> 0..255; +256 -> "100".."1ff"; drop the leading 1 => zero-padded 2-char hex.
		sb.append(Packages.java.lang.Integer.toHexString(sr.nextInt(256) + 256).substring(1));
	}
	var token = "" + sb.toString();
	form.setConfig("bearerToken", token);
	form.updateControl("bearerToken");
	// The CE is an Eclipse/SWT app, so use the SWT clipboard — AWT's Toolkit
	// clipboard doesn't reliably reach the OS pasteboard from SWT, and AWT modal
	// dialogs freeze the CE on macOS. This is non-modal: worst case it falls into
	// the catch (copied=false), it cannot hang the CE.
	var copied = false;
	try {
		var Display = Packages.org.eclipse.swt.widgets.Display;
		var display = Display.getCurrent();
		if (display == null) {
			display = Display.getDefault();
		}
		var clip = new Packages.org.eclipse.swt.dnd.Clipboard(display);
		clip.setContents([token], [Packages.org.eclipse.swt.dnd.TextTransfer.getInstance()]);
		clip.dispose();
		copied = true;
	} catch (e) {
		copied = false;
	}
	// form.alert is the CE's own properly-parented dialog (safe, no hang).
	var note = copied ? form.translate("GEN_TOKEN_COPIED") : form.translate("GEN_TOKEN_NOCOPY");
	form.alert(form.translate("GEN_TOKEN_MSG") + "\n\n" + token + "\n\n" + note);
}
]]></parameter>
		</Form>
