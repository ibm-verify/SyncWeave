<?xml version="1.0" encoding="UTF-8"?>
<MetamergeConfig created="Phase 1" version="10.0.0">
	<Folder name="Connectors">
		<Connector name="MCPServerConnector">
			<SupportedModes>Server,Iterator</SupportedModes>
			<Configuration>
				<parameter name="connectorType">com.vdi.di.connector.McpServerConnector</parameter>
				<parameter name="parserOption">Optional</parameter>
				<!-- serverReply=true makes the AssemblyLine call replyEntry() at end of
				     cycle for the tools/call path (which returns a work Entry). Without
				     it, only the direct in-getNextEntry replies fire and tools/call
				     hangs the client. Same flag the stock HTTPServerConnector sets. -->
				<parameter name="serverReply">true</parameter>
				<parameter name="endpointPath">/mcp</parameter>
				<parameter name="bindAddress">127.0.0.1</parameter>
				<parameter name="tcpPort">8443</parameter>
				<parameter name="useSSL">false</parameter>
				<parameter name="needClientAuth">false</parameter>
				<parameter name="authMode">bearer</parameter>
				<parameter name="bearerToken"></parameter>
				<parameter name="toolCatalog">[]</parameter>
				<parameter name="allowedOrigins"></parameter>
				<parameter name="healthPath"></parameter>
				<parameter name="maxRequestBytes">0</parameter>
				<parameter name="actorHeader"></parameter>
			</Configuration>
			<Schema name="Input">
				<SchemaItem>
					<Name>http.body</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.tool</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.requestId</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.protocolVersion</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.arguments</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.actor</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.actorCn</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
			</Schema>
			<Schema name="Output">
				<SchemaItem>
					<Name>$mcp.result</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.structured</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$mcp.isError</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
			</Schema>
		</Connector>
	</Folder>
